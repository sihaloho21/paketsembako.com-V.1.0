import { defineConfig } from "vite";
import react from "@vitejs/plugin-react";
import tailwindcss from "@tailwindcss/vite";
import path from "path";

// Untuk Netlify, PORT dan BASE_PATH adalah opsional
// Gunakan default jika tidak tersedia
const port = Number(process.env.PORT || 5173);
const basePath = process.env.BASE_PATH || "/";

export default defineConfig({
  base: basePath,
  plugins: [
    react(),
    tailwindcss(),
    // Hanya load Replit plugins jika di environment Replit
    ...(process.env.REPL_ID !== undefined
      ? [
          // Replit-specific plugins akan di-load di sini jika diperlukan
        ]
      : []),
  ],
  resolve: {
    alias: {
      "@": path.resolve(import.meta.dirname, "src"),
      "@assets": path.resolve(import.meta.dirname, "..", "..", "attached_assets"),
    },
    dedupe: ["react", "react-dom"],
  },
  root: path.resolve(import.meta.dirname),
  build: {
    outDir: path.resolve(import.meta.dirname, "dist"),
    emptyOutDir: true,
    // Optimasi untuk Netlify
    minify: "terser",
    sourcemap: false,
  },
  server: {
    port,
    strictPort: false, // Jangan strict untuk Netlify
    host: "0.0.0.0",
    allowedHosts: true,
    fs: {
      strict: true,
    },
  },
  preview: {
    port,
    host: "0.0.0.0",
    allowedHosts: true,
  },
});
