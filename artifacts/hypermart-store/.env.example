# Environment variables untuk hypermart-store

# Port untuk development server
PORT=5173

# Base path untuk aplikasi (untuk sub-directory hosting)
BASE_PATH=/

# Google Apps Script Web App URL
# Ganti dengan URL deployment ID Anda setelah deploy GAS
# Format: https://script.google.com/macros/s/{DEPLOYMENT_ID}/usercontent
VITE_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/usercontent
